# Copy to .env.local for local development. In production set these in
# Vercel → Project → Settings → Environment Variables.

# MongoDB Atlas connection string (database user with readWrite on the db)
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=campuscart

# Better Auth — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public site URL (used for auth callbacks and links in e-mails)
SITE_URL=http://localhost:5173

# Cloudinary (Dashboard → API Keys): cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_URL=

# Gmail API sender for order / password e-mails (see README)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER=
GMAIL_SENDER_NAME=CampusCart
REQUIRE_EMAIL_VERIFICATION=false

# Comma-separated admin e-mails (promoted after their e-mail is verified)
ADMIN_EMAILS=
# Random string ≥16 chars; Vercel Cron sends it to /api/cron/order-emails
CRON_SECRET=

# Development only: show the sample stores/products (never included in production builds)
VITE_SAMPLE_CATALOG=false
